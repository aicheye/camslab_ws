<?xml version="1.0"?>
<!--
  Yahboom ROSMASTER R2 for Gazebo Fortress.

  Wheel and steering-pivot positions are from Yahboom's yahboomcar_R2.urdf.xacro
  (base_footprint -> base_link is +0.0215 m in z). Meshes are the same file's STL
  exports and are used for visuals only; collisions are primitives. Masses are
  estimates, because the URDF's SolidWorks masses (0.52 kg chassis) are too low.

  Model frame = base_footprint: on the ground below the base_link origin, which is
  0.11607 m ahead of the rear axle. The pose on the `pose` topic is this frame.

    wheel_base       0.11922 + 0.11607 = 0.23529 m
    wheel_separation 2 * 0.08425       = 0.1685 m
    wheel_radius     0.0345 m (mesh bounding box)
    steering_limit   0.6 rad (URDF joint limit)

  The AckermannSteering system reads geometry_msgs/Twist semantics on
  /model/r2/cmd_vel: linear.x [m/s] of the rear axle and angular.z [rad/s] yaw
  rate. It converts (v, w) to a steering angle, so |w| is limited by
  |v| tan(0.6) / 0.23529 and w with v = 0 does not turn the car.
-->
<sdf version="1.8">
  <model name="r2">

    <link name="base_link">
      <pose>0 0 0.0215 0 0 0</pose>
      <inertial>
        <pose>0 0 0.06 0 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.00493</ixx><iyy>0.01473</iyy><izz>0.01633</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0.01 0 0.07 0 0 0</pose>
        <geometry><box><size>0.28 0.14 0.08</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh><uri>model://r2/meshes/base_link.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0 0.63 0.24 1</ambient>
          <diffuse>0 0.63 0.24 1</diffuse>
        </material>
      </visual>
      <visual name="camera">
        <pose>0.095117 0 0.09955 0 0.0057171 0</pose>
        <geometry>
          <mesh><uri>model://r2/meshes/camera_link.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Rear drive wheels. Joint axis +y, so positive joint velocity drives forward. -->
    <link name="rear_left_wheel">
      <pose>-0.11607 0.08425 0.0345 0 0 0</pose>
      <inertial>
        <mass>0.06</mass>
        <inertia>
          <ixx>2.12e-5</ixx><iyy>3.57e-5</iyy><izz>2.12e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.0345</radius><length>0.026</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><mesh><uri>model://r2/meshes/back_right_link.stl</uri></mesh></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>

    <link name="rear_right_wheel">
      <pose>-0.11607 -0.08425 0.0345 0 0 0</pose>
      <inertial>
        <mass>0.06</mass>
        <inertia>
          <ixx>2.12e-5</ixx><iyy>3.57e-5</iyy><izz>2.12e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.0345</radius><length>0.026</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><mesh><uri>model://r2/meshes/back_right_link.stl</uri></mesh></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- Front steering knuckles, pivot at the wheel centre. -->
    <link name="front_left_steer">
      <pose>0.11922 0.08425 0.0345 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <link name="front_right_steer">
      <pose>0.11922 -0.08425 0.0345 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <joint name="front_left_steer_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_steer</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.6</lower><upper>0.6</upper></limit></axis>
    </joint>

    <joint name="front_right_steer_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_steer</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.6</lower><upper>0.6</upper></limit></axis>
    </joint>

    <link name="front_left_wheel">
      <pose>0.11922 0.08425 0.0345 0 0 0</pose>
      <inertial>
        <mass>0.06</mass>
        <inertia>
          <ixx>2.12e-5</ixx><iyy>3.57e-5</iyy><izz>2.12e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.0345</radius><length>0.026</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><mesh><uri>model://r2/meshes/back_right_link.stl</uri></mesh></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>

    <link name="front_right_wheel">
      <pose>0.11922 -0.08425 0.0345 0 0 0</pose>
      <inertial>
        <mass>0.06</mass>
        <inertia>
          <ixx>2.12e-5</ixx><iyy>3.57e-5</iyy><izz>2.12e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.0345</radius><length>0.026</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><mesh><uri>model://r2/meshes/back_right_link.stl</uri></mesh></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steer</parent>
      <child>front_left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steer</parent>
      <child>front_right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <plugin filename="ignition-gazebo-ackermann-steering-system"
            name="ignition::gazebo::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <kingpin_width>0.1685</kingpin_width>
      <steering_limit>0.6</steering_limit>
      <wheel_base>0.23529</wheel_base>
      <wheel_separation>0.1685</wheel_separation>
      <wheel_radius>0.0345</wheel_radius>
      <min_velocity>-1.0</min_velocity>
      <max_velocity>1.0</max_velocity>
      <min_acceleration>-3.0</min_acceleration>
      <max_acceleration>3.0</max_acceleration>
    </plugin>

    <!-- Joint positions and velocities on /world/<world>/model/<name>/joint_state. -->
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher"/>

    <!-- Model pose in the world frame on /model/r2/pose. -->
    <plugin filename="ignition-gazebo-pose-publisher-system"
            name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>100</update_frequency>
    </plugin>
  </model>
</sdf>
